{
  "type": "object",
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "resource_get",
        "resource_set"
      ],
      "description": "Selects the operation."
    },
    "name": {
      "type": "string",
      "description": "VICE resource name (example: SidEngine, C64Model).",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Za-z0-9_.-]{0,63}$"
    },
    "value": {
      "description": "VICE resource value (string or integer).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    }
  },
  "required": [
    "op"
  ],
  "description": "VICE emulator operations available via the c64_vice tool.\n\nOperations:\n- resource_get: Read a VICE configuration resource (safe prefixes only).\n- resource_set: Write a VICE configuration resource (safe prefixes only)."
}
