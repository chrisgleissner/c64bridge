{
  "type": "object",
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "list_checkpoints",
        "get_checkpoint",
        "create_checkpoint",
        "delete_checkpoint",
        "toggle_checkpoint",
        "set_condition",
        "list_registers",
        "get_registers",
        "set_registers",
        "step",
        "step_return",
        "get_monitor_state",
        "wait_for_state",
        "nuclear_reset",
        "continue_execution"
      ],
      "description": "Selects the operation."
    },
    "id": {
      "type": "integer",
      "description": "Debugger checkpoint identifier.",
      "minimum": 1
    },
    "address": {
      "type": "string",
      "description": "Start address (e.g. $0801).",
      "minLength": 1
    },
    "endAddress": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional end address for range.",
      "minLength": 1
    },
    "stopOnHit": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Pause execution when hit (default true).",
      "default": true
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether the checkpoint is enabled (default true). Limits depend on op."
    },
    "temporary": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Automatically remove after first hit.",
      "default": false
    },
    "label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional human-readable label stored in-process.",
      "maxLength": 64
    },
    "operations": {
      "type": [
        "object",
        "null"
      ],
      "description": "Checkpoint operation filters.",
      "properties": {
        "execute": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Trigger on execute (default true).",
          "default": true
        },
        "load": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Trigger on memory load.",
          "default": false
        },
        "store": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Trigger on memory store.",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "memspace": {
      "type": [
        "integer",
        "null"
      ],
      "description": "VICE memory space (0=CPU, 1=Drive8, etc.).",
      "minimum": 0,
      "maximum": 4
    },
    "expression": {
      "type": "string",
      "description": "VICE monitor conditional expression.",
      "minLength": 1
    },
    "registers": {
      "type": [
        "array",
        "null"
      ],
      "description": "Registers to include.",
      "items": {
        "type": "object",
        "description": "Selects a register by id or name.",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Register name (case-insensitive)."
          },
          "id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Register id.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "writes": {
      "type": "array",
      "description": "Register writes to apply.",
      "items": {
        "type": "object",
        "description": "Register write descriptor.",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Register name (case-insensitive)."
          },
          "id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Register id.",
            "minimum": 0
          },
          "value": {
            "type": "integer",
            "description": "Value to write.",
            "minimum": 0
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Number of instructions to step.",
      "minimum": 1,
      "default": 1
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "description": "Step mode (into or over).",
      "enum": [
        "into",
        "over"
      ]
    },
    "expectedPC": {
      "type": [
        "string",
        "null"
      ],
      "description": "Target PC address to wait for (e.g. $0810).",
      "minLength": 1
    },
    "timeoutMs": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Maximum wait time in milliseconds.",
      "minimum": 1,
      "maximum": 60000,
      "default": 5000
    },
    "pollMs": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Poll interval in milliseconds.",
      "minimum": 10,
      "maximum": 1000,
      "default": 100
    }
  },
  "required": [
    "op"
  ],
  "description": "Available debugger operations.\n\nOperations:\n- list_checkpoints: List all active VICE checkpoints (breakpoints). Required inputs: none.\n- get_checkpoint: Fetch a single checkpoint by id. Required inputs: id.\n- create_checkpoint [write]: Create a new checkpoint (breakpoint) in VICE. Required inputs: address. Optional inputs: endAddress, stopOnHit, enabled, temporary, label, operations, memspace.\n- delete_checkpoint [write]: Remove a checkpoint by id. Required inputs: id.\n- toggle_checkpoint [write]: Enable or disable a checkpoint by id. Required inputs: id, enabled.\n- set_condition [write]: Attach a conditional expression to a checkpoint. Required inputs: id, expression.\n- list_registers: List available registers (metadata). Required inputs: none. Optional inputs: memspace.\n- get_registers: Read register values, optionally filtered by name or id. Required inputs: none. Optional inputs: memspace, registers.\n- set_registers [write]: Write register values. Required inputs: writes. Optional inputs: memspace.\n- step [write]: Single-step CPU execution. Required inputs: none. Optional inputs: count, mode.\n- step_return [write]: Continue execution until the current routine returns. Required inputs: none.\n- get_monitor_state: Read CPU registers and return the current monitor state. Required inputs: none. Optional inputs: memspace.\n- wait_for_state: Wait until the CPU is stopped (checkpoint hit or step) and, when expectedPC is given, until PC equals it, or until the timeout elapses. Without a debug session the registers are polled. Required inputs: none. Optional inputs: expectedPC, timeoutMs, pollMs.\n- nuclear_reset [destructive]: Kill and restart the VICE process (managed instances only). Required inputs: none.\n- continue_execution [write]: Exit the Binary Monitor and resume CPU execution (BM 0xAA Exit). Required inputs: none.",
  "additionalProperties": false
}
