{
  "type": "object",
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "list_checkpoints",
        "get_checkpoint",
        "create_checkpoint",
        "delete_checkpoint",
        "toggle_checkpoint",
        "set_condition",
        "list_registers",
        "get_registers",
        "set_registers",
        "step",
        "step_return",
        "get_monitor_state",
        "wait_for_state",
        "nuclear_reset",
        "continue_execution",
        "profile_border",
        "diagnose"
      ],
      "description": "Selects the operation."
    },
    "id": {
      "type": "integer",
      "description": "Debugger checkpoint identifier.",
      "minimum": 1
    },
    "address": {
      "type": "string",
      "description": "Start address: $HHHH, 0xHHHH, decimal, a loaded program label or documented name (screen, CHROUT), optionally +n or -n.",
      "minLength": 1
    },
    "endAddress": {
      "type": [
        "string",
        "null"
      ],
      "description": "End address (inclusive) of an address range, in the same forms as address.",
      "minLength": 1
    },
    "stopOnHit": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Pause execution when hit (default true).",
      "default": true
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether the checkpoint is enabled. Limits depend on op."
    },
    "temporary": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Automatically remove after first hit.",
      "default": false
    },
    "label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional human-readable label stored in-process.",
      "maxLength": 64
    },
    "operations": {
      "type": [
        "object",
        "null"
      ],
      "description": "Checkpoint operation filters.",
      "properties": {
        "execute": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Trigger on execute (default true).",
          "default": true
        },
        "load": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Trigger on memory load.",
          "default": false
        },
        "store": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Trigger on memory store.",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "memspace": {
      "type": [
        "integer",
        "null"
      ],
      "description": "VICE memory space (0=CPU, 1=Drive8, etc.).",
      "minimum": 0,
      "maximum": 4
    },
    "expression": {
      "type": "string",
      "description": "VICE monitor conditional expression.",
      "minLength": 1
    },
    "registers": {
      "type": [
        "array",
        "null"
      ],
      "description": "Registers to include.",
      "items": {
        "type": "object",
        "description": "Selects a register by id or name.",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Register name (case-insensitive)."
          },
          "id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Register id.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "writes": {
      "type": "array",
      "description": "Register writes to apply.",
      "items": {
        "type": "object",
        "description": "Register write descriptor.",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Register name (case-insensitive)."
          },
          "id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Register id.",
            "minimum": 0
          },
          "value": {
            "type": [
              "integer",
              "string"
            ],
            "description": "Value: integer, or string such as \"$C000\" or a label[+n]."
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Number of instructions to step.",
      "minimum": 1,
      "default": 1
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "description": "Step mode (into or over).",
      "enum": [
        "into",
        "over"
      ]
    },
    "expectedPC": {
      "type": [
        "string",
        "null"
      ],
      "description": "PC address to wait for, in the same forms as address.",
      "minLength": 1
    },
    "timeoutMs": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Maximum wait time in milliseconds.",
      "minimum": 1,
      "maximum": 60000,
      "default": 5000
    },
    "pollMs": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Poll interval in milliseconds.",
      "minimum": 10,
      "maximum": 1000,
      "default": 100
    },
    "markers": {
      "type": "array",
      "items": {
        "properties": {
          "name": {},
          "color": {}
        }
      }
    },
    "idleColor": {
      "type": "integer"
    },
    "frames": {
      "type": "integer"
    },
    "column": {
      "enum": [
        "left",
        "right"
      ]
    },
    "standard": {
      "enum": [
        "pal",
        "ntsc"
      ]
    },
    "samples": {
      "type": "integer"
    },
    "sampleIntervalMs": {
      "type": "integer"
    },
    "codeRange": {
      "type": "object",
      "properties": {
        "start": {},
        "end": {}
      }
    },
    "stackDepth": {
      "type": "integer"
    },
    "frameCounter": {
      "type": "string"
    }
  },
  "required": [
    "op"
  ],
  "description": "Available debugger operations.\n\nOperations:\n- list_checkpoints: List all active VICE checkpoints (breakpoints).\n- get_checkpoint: Fetch a single checkpoint by id. Required: id.\n- create_checkpoint [write]: Create a new checkpoint (breakpoint) in VICE. Required: address. Optional: endAddress, stopOnHit, enabled, temporary, label, operations, memspace.\n- delete_checkpoint [write]: Remove a checkpoint by id. Required: id.\n- toggle_checkpoint [write]: Enable or disable a checkpoint by id. Required: id, enabled.\n- set_condition [write]: Attach a conditional expression to a checkpoint. Required: id, expression.\n- list_registers: List available registers (metadata). Optional: memspace.\n- get_registers: Read register values, optionally filtered by name or id. Optional: memspace, registers.\n- set_registers [write]: Write register values. Required: writes. Optional: memspace.\n- step [write]: Single-step CPU execution. Optional: count, mode.\n- step_return [write]: Continue execution until the current routine returns.\n- get_monitor_state: Read CPU registers and return the current monitor state. Optional: memspace.\n- wait_for_state: Wait until the CPU is stopped (checkpoint or step) and, with expectedPC, PC equals it, or the timeout elapses. Without a debug session the registers are polled. Optional: expectedPC, timeoutMs, pollMs.\n- nuclear_reset [destructive]: Kill and restart the VICE process (managed instances only).\n- continue_execution [write]: Exit the Binary Monitor and resume CPU execution (BM 0xAA Exit).\n- profile_border [c64u, vice]: Raster lines per $D020 marker colour; cycles approximate. Required: markers, idleColor. Optional: frames, column, standard.\n- diagnose [vice]: Crash verdict from PC, stack, vectors. Optional: samples, sampleIntervalMs, codeRange, stackDepth, frameCounter.",
  "additionalProperties": false
}
