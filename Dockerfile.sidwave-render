ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE}

# Reuse the project builder's VICE installation (including its ROM packages) and install only the offline renderers.
USER root
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ffmpeg sidplayfp && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
USER c64bridge
